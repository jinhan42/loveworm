[Unit]
Description=Loveworm Monitoring System
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/loveworm
ExecStart=/home/pi/loveworm/backend/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/pi/loveworm

[Install]
WantedBy=multi-user.target
